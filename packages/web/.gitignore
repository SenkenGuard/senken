node_modules

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
# `senken-api`'s `web` feature embeds this directory via rust-embed, which
# needs the directory to exist to compile at all (verified;
# see crates/api/README.md). `.gitkeep` is tracked so a clean checkout has
# it even though a real build's output does not need to be.
/build/*
!/build/.gitkeep

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Vitest browser mode's failure screenshots, and Playwright's own reports —
# both are run output, never source.
**/__screenshots__
/.vitest-attachments
/test-results
/playwright-report
/blob-report

# `tests/e2e/global-setup.ts`'s own run state: a live session token, the
# spawned server's pid/data-dir, and a zipped fixture plugin it packages on
# the fly. Regenerated by every run, never something to commit.
/tests/e2e/.server.json
/tests/e2e/.auth.json
/tests/e2e/.artifacts.json
/tests/e2e/artifacts
