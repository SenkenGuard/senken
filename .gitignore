# Cargo
/target

# Local data directory created by the runtime (see senken_runtime::DEFAULT_DATA_DIR)
/.data

# Reference material vendored for study; not part of the project
/refs

# packages/web (SvelteKit SPA) has its own .gitignore for
# node_modules/.svelte-kit/build (build's exception for .gitkeep lives
# there, since a nested ignore of the whole directory can't be un-ignored
# from here). Bun is the package manager (bun.lock files ARE committed);
# nothing should ever produce an npm/yarn/pnpm lockfile.
/package-lock.json
/packages/web/package-lock.json
/yarn.lock
/packages/web/yarn.lock
/pnpm-lock.yaml
/packages/web/pnpm-lock.yaml

# `tauri-build`'s generated capability/ACL schemas (`apps/senken`'s `gui`
# feature) — regenerated by every build, same as `/target`.
/apps/senken/gen/schemas

# Editors / OS
.idea
.vscode
.DS_Store

# Environment
.env
.env.*

# Bun workspace installs hoist here.
/node_modules
