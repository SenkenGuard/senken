# Cargo
/target
# A `target/` anywhere else is a sub-workspace built without
# `CARGO_TARGET_DIR` pointing at the shared build directory. Ignored so
# build output can never be committed; the build script is what keeps it
# from being created in the first place.
target/

# Local data directory created by the runtime (see senken_runtime::DEFAULT_DATA_DIR)
/.data
# A `.data` anywhere else is a test that forgot its own data directory —
# ignored so it can never be committed, and fixed where it is found.
.data/

# Reference material vendored for study; not part of the project
/refs

# packages/web (SvelteKit SPA) has its own .gitignore for
# node_modules/.svelte-kit/build (build's exception for .gitkeep lives
# there, since a nested ignore of the whole directory can't be un-ignored
# from here). Bun is the package manager (bun.lock files ARE committed);
# nothing should ever produce an npm/yarn/pnpm lockfile.
/package-lock.json
/packages/web/package-lock.json
/yarn.lock
/packages/web/yarn.lock
/pnpm-lock.yaml
/packages/web/pnpm-lock.yaml

# `tauri-build`'s generated capability/ACL schemas (`apps/senken`'s `gui`
# feature) — regenerated by every build, same as `/target`.
/apps/senken/gen/schemas

# A venue's built `wasm32-wasip2` component, produced by
# `plugins/build-venue.sh <venue>` and embedded into that venue's native
# crate via `include_bytes!` — regenerated by every build, same as
# `/target`, and by the same script CI runs before `cargo build`/`cargo
# test` touch that crate.
/plugins/*/dist

# Editors / OS
.idea
.vscode
.DS_Store

# Environment
.env
.env.*

# Bun workspace installs hoist here.
/node_modules
